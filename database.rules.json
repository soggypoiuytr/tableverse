{"rules":{".read":false,".write":false,"presence":{".read":"auth != null","$uid":{"$session":{".write":"auth != null && auth.uid === $uid",".validate":"newData.hasChildren(['world','name','photoURL','frameColor','updatedAt'])","world":{".validate":"newData.isString() && (newData.val() === 'aurality' || newData.val() === 'clockworks' || newData.val() === 'arvore' || newData.val() === 'bruxas')"},"name":{".validate":"newData.isString() && newData.val().length > 0 && newData.val().length <= 32"},"photoURL":{".validate":"newData.isString() && newData.val().length <= 300 && (newData.val() === '' || newData.val().beginsWith('https://cdn.discordapp.com/'))"},"frameColor":{".validate":"newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"},"updatedAt":{".validate":"newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"},"$other":{".validate":false}}}}}}
