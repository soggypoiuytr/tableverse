{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        "$session": {
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"
          },
          "world": {
            ".validate": "newData.isString() && (newData.val() === 'menu' || newData.val() === 'aurality' || newData.val() === 'clockworks' || newData.val() === 'arvore' || newData.val() === 'bruxas')"
          },
          ".validate": "newData.hasChildren(['world','name','photoURL','frameColor','updatedAt'])",
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && auth.uid === $uid",
          "photoURL": {
            ".validate": "newData.isString() && newData.val().length <= 300 && (newData.val() === '' || newData.val().beginsWith('https://cdn.discordapp.com/'))"
          },
          "frameColor": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          }
        }
      }
    },
    "tableSessionsPreview": {
      "$world": {
        "config": {
          "gmUid": {
            ".write": false
          },
          "info": {
            ".write": "auth != null && root.child('tableSessionsPreview').child($world).child('config/gmUid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 12000"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null"
        },
        "scene": {
          ".write": "auth != null && root.child('tableSessionsPreview').child($world).child('config/gmUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['mode','mapId','updatedBy','updatedAt'])",
          "mode": {
            ".validate": "newData.val() === 'waiting' || newData.val() === 'map'"
          },
          "mapId": {
            ".validate": "newData.val() === 'concept-facility'"
          },
          "updatedBy": {
            ".validate": "newData.val() === auth.uid"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"
          },
          "tokens": {
            "$token": {
              ".validate": "$token.matches(/^t[0-9]{1,3}$/) && newData.hasChildren(['x','y'])",
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null"
        },
        "sheets": {
          ".read": false,
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth != null && root.child('tableSessionsPreview').child($world).child('config/gmUid').val() === auth.uid)",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name','concept','notes','updatedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "concept": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "notes": {
              ".validate": "newData.isString() && newData.val().length <= 12000"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}