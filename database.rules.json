{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        "$session": {
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"
          },
          "world": {
            ".validate": "newData.isString() && (newData.val() === 'menu' || newData.val() === 'aurality' || newData.val() === 'clockworks' || newData.val() === 'arvore' || newData.val() === 'bruxas')"
          },
          ".validate": "newData.hasChildren(['world','name','photoURL','frameColor','updatedAt'])",
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && auth.uid === $uid",
          "photoURL": {
            ".validate": "newData.isString() && newData.val().length <= 300 && (newData.val() === '' || newData.val().beginsWith('https://cdn.discordapp.com/'))"
          },
          "frameColor": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          }
        }
      }
    },
    "tableSessionsPreview": {
      "$world": {
        "gameplayTokens": {
          ".read": "auth != null && $world === 'aurality'",
          "$token": {
            "moveClient": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 25 && newData.val() <= 975"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 25 && newData.val() <= 875"
            },
            ".validate": "newData.hasChildren(['ownerUid','x','y','updatedBy','updatedAt']) && newData.child('ownerUid').val() === data.child('ownerUid').val() && (root.child('tableSessionsPreview/aurality/boardSettings/gridEnabled').val() !== true || newData.child('gridBypass').val() === true || (newData.child('x').val() % 50 === 25 && newData.child('y').val() % 50 === 25))",
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && $world === 'aurality' && root.child('tableSessionsPreview/aurality/scene/mode').val() === 'map' && (data.child('ownerUid').val() === auth.uid || root.child('tableSessionsPreview/aurality/config/gmUid').val() === auth.uid) && data.exists() && newData.exists()",
            "flipX": {
              ".validate": "newData.isBoolean()"
            },
            "ownerUid": {
              ".validate": "newData.val() === data.val()"
            },
            "gridBypass": {
              ".validate": "newData.isBoolean()"
            },
            "updatedBy": {
              ".validate": "newData.val() === auth.uid"
            },
            "moveSequence": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "flipY": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "mapPings": {
          ".read": "auth != null && $world === 'aurality'",
          "$uid": {
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 900"
            },
            ".validate": "newData.hasChildren(['x','y','frameColor','sequence','updatedAt'])",
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && $world === 'aurality' && auth.uid === $uid && root.child('tableSessionsPreview/aurality/scene/mode').val() === 'map'",
            "sequence": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "frameColor": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            }
          }
        },
        "gameplaySheets": {
          ".read": "auth != null && $world === 'aurality'",
          "$character": {
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"
            },
            "maxConcentration": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999"
            },
            ".validate": "newData.hasChildren(['life','maxLife','concentration','maxConcentration','updatedBy','updatedAt']) && (root.child('tableSessionsPreview/aurality/config/gmUid').val() === auth.uid || (newData.child('life').val() === ((newData.child('maxLife').val() - (data.child('maxLife').val() - data.child('life').val())) < 0 ? 0 : (newData.child('maxLife').val() - (data.child('maxLife').val() - data.child('life').val()))) && newData.child('concentration').val() === ((newData.child('maxConcentration').val() - (data.child('maxConcentration').val() - data.child('concentration').val())) < 0 ? 0 : (newData.child('maxConcentration').val() - (data.child('maxConcentration').val() - data.child('concentration').val())))))",
            "concentration": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && $world === 'aurality' && data.exists() && newData.exists() && (root.child('tableSessionsPreview/aurality/gameplayTokens').child($character).child('ownerUid').val() === auth.uid || root.child('tableSessionsPreview/aurality/config/gmUid').val() === auth.uid)",
            "maxLife": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999"
            },
            "life": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
            },
            "updatedBy": {
              ".validate": "newData.val() === auth.uid"
            }
          }
        },
        "config": {
          "gmUid": {
            ".write": false
          },
          "info": {
            ".write": "auth != null && root.child('tableSessionsPreview').child($world).child('config/gmUid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 12000"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null"
        },
        "cursors": {
          ".read": "auth != null && $world === 'aurality'",
          "$uid": {
            "$session": {
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 900"
              },
              ".validate": "newData.hasChildren(['x','y','name','photoURL','frameColor','updatedAt'])",
              "$other": {
                ".validate": false
              },
              ".write": "auth != null && $world === 'aurality' && auth.uid === $uid",
              "photoURL": {
                ".validate": "newData.isString() && newData.val().length <= 300 && (newData.val() === '' || newData.val().beginsWith('https://cdn.discordapp.com/'))"
              },
              "frameColor": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
              }
            }
          }
        },
        "scene": {
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"
          },
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['mode','mapId','updatedBy','updatedAt'])",
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && root.child('tableSessionsPreview').child($world).child('config/gmUid').val() === auth.uid",
          "mapId": {
            ".validate": "newData.val() === 'concept-facility'"
          },
          "mode": {
            ".validate": "newData.val() === 'waiting' || newData.val() === 'map'"
          },
          "tokens": {
            "$token": {
              ".validate": "$token.matches(/^t[0-9]{1,3}$/) && newData.hasChildren(['x','y'])",
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "updatedBy": {
            ".validate": "newData.val() === auth.uid"
          }
        },
        "sheets": {
          ".read": false,
          "$uid": {
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000"
            },
            ".read": "auth != null && (auth.uid === $uid || auth != null && root.child('tableSessionsPreview').child($world).child('config/gmUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name','concept','notes','updatedAt'])",
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && auth.uid === $uid",
            "concept": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "notes": {
              ".validate": "newData.isString() && newData.val().length <= 12000"
            }
          }
        },
        "physicalDice": {
          ".read": "auth != null && $world === 'aurality'",
          "current": {
            "count": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 6"
            },
            "originX": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "seed": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295"
            },
            "result": {
              ".validate": "newData.isNumber()"
            },
            ".validate": "newData.hasChildren(['id','ownerUid','sides','count','dieColor','seed','createdAt','result']) && (newData.child('result').val() === -1 || (newData.child('result').val() >= 0 && newData.child('result').val() <= newData.child('sides').val() * newData.child('count').val())) && newData.child('seed').val() % 1 === 0 && newData.child('result').val() % 1 === 0 && ((newData.child('id').val() === data.child('id').val() && newData.child('seed').val() === data.child('seed').val() && newData.child('sides').val() === data.child('sides').val() && newData.child('count').val() === data.child('count').val() && newData.child('dieColor').val() === data.child('dieColor').val() && newData.child('createdAt').val() === data.child('createdAt').val()) || (newData.child('id').val() !== data.child('id').val() && newData.child('result').val() === 0)) && (newData.child('result').val() === 0 || ((newData.child('count').val() === 1 && newData.child('values').hasChildren(['0'])) || (newData.child('count').val() === 2 && newData.child('values').hasChildren(['0','1'])) || (newData.child('count').val() === 3 && newData.child('values').hasChildren(['0','1','2'])) || (newData.child('count').val() === 4 && newData.child('values').hasChildren(['0','1','2','3'])) || (newData.child('count').val() === 5 && newData.child('values').hasChildren(['0','1','2','3','4'])) || (newData.child('count').val() === 6 && newData.child('values').hasChildren(['0','1','2','3','4','5'])))) && newData.hasChildren(['fromToken','originX','originY']) && (newData.child('id').val() !== data.child('id').val() || (newData.child('fromToken').val() === data.child('fromToken').val() && newData.child('originX').val() === data.child('originX').val() && newData.child('originY').val() === data.child('originY').val())) && (newData.child('fromToken').val() !== true || root.child('tableSessionsPreview/aurality/config/gmUid').val() !== auth.uid)",
            "dieColor": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && $world === 'aurality' && root.child('tableSessionsPreview/aurality/scene/mode').val() === 'map' && newData.child('ownerUid').val() === auth.uid && ((!data.exists()) || (newData.child('id').val() === data.child('id').val() && data.child('ownerUid').val() === auth.uid) || data.child('result').val() !== 0 || now - data.child('createdAt').val() > 35000)",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "fromToken": {
              ".validate": "newData.isBoolean()"
            },
            "ownerUid": {
              ".validate": "newData.val() === auth.uid"
            },
            "sides": {
              ".validate": "newData.val() === 4 || newData.val() === 6 || newData.val() === 8 || newData.val() === 10 || newData.val() === 12 || newData.val() === 20"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && (newData.val() === data.val() || (newData.val() <= now + 1000 && newData.val() >= now - 60000))"
            },
            "values": {
              "$index": {
                ".validate": "$index.matches(/^[0-5]$/) && newData.isNumber() && newData.val() % 1 === 0 && (newData.val() === -1 || (newData.val() >= 1 && newData.val() <= newData.parent().parent().child('sides').val()))"
              }
            },
            "originY": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 900"
            }
          }
        },
        "boardSettings": {
          ".read": "auth != null && $world === 'aurality'",
          "gridEnabled": {
            ".write": "auth != null && $world === 'aurality' && root.child('tableSessionsPreview/aurality/config/gmUid').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}